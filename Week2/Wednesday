//Array Insertion using a new array

import java.util.*;

class Main {
    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        System.out.println("Enter array size:");
        int n = sc.nextInt();

        int[] a = new int[n];

        System.out.println("Enter " + n + " elements:");
        for(int i = 0; i < n; i++) {
            a[i] = sc.nextInt();
        }

        System.out.println("Enter new element to insert:");
        int val = sc.nextInt();

        System.out.println("Enter position (index) to insert:");
        int pos = sc.nextInt();

        int[] b = new int[n + 1];

        if(pos < 0 || pos > n) {
            System.out.println("Invalid position");
        } else {

            // Copy elements before insertion position

            for(int i = 0; i < pos; i++) {
                b[i] = a[i];
            }

            // Insert new element

            b[pos] = val;

            // Shift remaining elements right

            for(int i = pos; i < n; i++) {
                b[i + 1] = a[i];
            }

            System.out.println("New array after insertion:");

            for(int i = 0; i < b.length; i++) {
                System.out.print(b[i] + " ");
            }
        }
    }
}
//Array Deletion using index

import java.util.*;

class Main {
    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        System.out.println("Enter array size:");
        int n = sc.nextInt();

        int[] a = new int[n];

        System.out.println("Enter " + n + " elements:");
        for(int i = 0; i < n; i++) {
            a[i] = sc.nextInt();
        }

        System.out.println("Enter position (index) to delete:");
        int posd = sc.nextInt();

        if(posd < 0 || posd >= n) {
            System.out.println("Invalid position");
        } else {

            for(int i = posd; i < n - 1; i++) {
                a[i] = a[i + 1];
            }

            n--;

            System.out.println("Array after deletion:");

            for(int i = 0; i < n; i++) {
                System.out.print(a[i] + " ");
            }
        }
    }
}
