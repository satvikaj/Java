import java.util.*;
class Main {
    public static void main(String[] args) {
        Scanner sc=new Scanner(System.in);
        System.out.println("Enter row size: ");
        int r=sc.nextInt();
        System.out.println("Enter column size: ");
        int c=sc.nextInt();
        int[][] a=new int[r][c];
        System.out.println("Enter array elements: ");
        for(int i=0;i<r;i++){
            for(int j=0;j<c;j++){
                a[i][j]=sc.nextInt();
            }
        }
        // print array 
        // row wise elemets 
        System.out.println("matrix elements row wise: ");
        for(int i=0;i<r;i++){
            for(int j=0;j<c;j++){
                System.out.print(a[i][j]+" ");
            }
            System.out.println();
        }
        System.out.println("Column-wise elements:");

        for(int j = 0; j < c; j++) {
            for(int i = 0; i < r; i++) {
                System.out.print(a[i][j] + " ");
            }
            System.out.println();
        }
        int sum = 0;

        for(int i = 0; i < r; i++) {
            for(int j = 0; j < c; j++) {
                sum = sum + a[i][j];
            }
        }

        System.out.println("Sum of all elements: " + sum);
        // Row-wise sum
        for(int i = 0; i < r; i++) {

            int rsum = 0;

            for(int j = 0; j < c; j++) {
                rsum = rsum + a[i][j];
            }

            System.out.println("Sum of row " + (i+1) + ": " + rsum);
        }
        // Column-wise sum
        for(int j = 0; j < c; j++) {

            int csum = 0;

            for(int i = 0; i < r; i++) {
                csum = csum + a[i][j];
            }

            System.out.println("Sum of column " + (j+1) + ": " + csum);
        }
        //largest and smallest
        int largest = a[0][0];
        int smallest = a[0][0];

        for(int i = 0; i < r; i++) {
            for(int j = 0; j < c; j++) {

                if(a[i][j] > largest) {
                    largest = a[i][j];
                }

                if(a[i][j] < smallest) {
                    smallest = a[i][j];
                }
            }
        }

        System.out.println("Largest element: " + largest);
        System.out.println("Smallest element: " + smallest);
        //transpose
        int[][] transpose= new int[c][r];
        for(int i=0;i<r;i++){
            for(int j=0;j<c;j++){
                transpose[j][i]=a[i][j];
            }
        }
        System.out.println("Transpose of matrix: ");
        for(int i=0;i<c;i++){
            for(int j=0;j<r;j++){
                System.out.print(transpose[i][j]+" ");
            }
            System.out.println();
        }
        
    }
}
