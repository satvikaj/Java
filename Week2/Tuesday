import java.util.*;
class Main {
    public static void main(String[] args) {
        Scanner sc=new Scanner(System.in);
        int[] n=new int[5];
        int[] a={10,20,304,50,60};
        int sum=0;
        double avg = 0;
        int even = 0;
        int odd = 0;
        int pos=0;
        int neg=0;
        for(int i = 0; i < a.length; i++) {
            System.out.println(a[i]);
        }
        System.out.println("Enter elements:");
        for(int i=0;i<n.length;i++){
            n[i]=sc.nextInt();
            sum = sum + n[i];
            if(n[i] % 2 == 0) {
                even++;
                System.out.println(n[i] + " is Even");
            } else {
                odd++;
                System.out.println(n[i] + " is Odd");
            }
        }
        for(int i=0;i<n.length;i++){
            if(n[i] >0) {
                pos++;
                System.out.println(n[i] + " is positive");
            } else if(n[i] < 0) {
                neg++;
                System.out.println(n[i] + " is Negative");
            }else{
                System.out.println(n[i] + " is Zero");
            }
            
        }
        avg = (double)sum / n.length;
        int max=n[0];
        int min=n[0];
        for(int i=1;i<n.length;i++){
            
            if(n[i] > max) {
                max = n[i];
            }
            if(n[i] < min) {
                min = n[i];
            }
            
        }
        System.out.println("Array elements:");

        for(int i = 0; i < n.length; i++) {
            System.out.println(n[i]);
        }
        System.out.println("Sum of array elements: " + sum);
        System.out.println("Average of array elements: " + avg);
        System.out.println("Largest element: " + max);
        System.out.println("Smallest element: " + min);
        System.out.println("Even numbers count: " + even);
        System.out.println("Odd numbers count: " + odd);
        System.out.println("Array elements in reverse order:");

        for(int i = n.length - 1; i >= 0; i--) {
            System.out.println(n[i]);
        }
        int[] b = new int[a.length];
        int[] c = new int[5];
        for(int i = 0; i < a.length; i++) {
            b[i] = a[i];
        }
        for(int i = 0; i < n.length; i++) {
            c[i] = n[i];
        }

        System.out.println("Copied array:");

        for(int i = 0; i < b.length; i++) {
            System.out.println(b[i]);
        }
        System.out.println("Copied user entered  array:");

        for(int i = 0; i < c.length; i++) {
            System.out.println(c[i]);
        }
    }
}
